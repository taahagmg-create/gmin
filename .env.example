# Copy to .env.local and fill in. Every one of these is optional in the scaffold —
# missing values keep the matching integration in stub mode (see src/lib/integrations.ts).

# Make.com — lead routing into CRM (brief §9)
MAKE_LEADS_WEBHOOK_URL=
MAKE_FINANCE_WEBHOOK_URL=

# Marenly — finance lead delivery. BOTH are required before anything is posted:
# a key without an endpoint leaves submitFinanceLead() in stub mode by design.
MAREN_API_KEY=
MAREN_LEAD_ENDPOINT=

# Retell AI — the "Maren Chat" agent behind the website chat widget.
# Server-only: no NEXT_PUBLIC_ prefix, so the key never reaches the browser.
# Both must be set, or chat falls back to a stub reply.
RETELL_API_KEY=
RETELL_AGENT_ID=

# ElevenLabs — vehicle narration, Host+Reel voice profile (Phase 2)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Video hosting — Mux or Cloudflare Stream
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Inventory source. "autostock" (default) reads live stock from the sitemap on
# esteemcars.co.nz; "sample" uses fixed local data for offline work.
INVENTORY_SOURCE=

# Inventory CMS — Sanity or Supabase (Phase 2, if stock ever moves off Autostock)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
